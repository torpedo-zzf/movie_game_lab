{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FMVStoryGraph",
  "type": "object",
  "required": [
    "chapter_id",
    "title",
    "start_node",
    "nodes"
  ],
  "properties": {
    "chapter_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "start_node": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "node_type",
          "video"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "node_type": {
            "type": "string",
            "enum": [
              "video_play",
              "choice_branch",
              "item_discovery",
              "qte_event",
              "ending"
            ]
          },
          "speaker": {
            "type": "string"
          },
          "dialogue": {
            "type": "string"
          },
          "video": {
            "type": "object",
            "required": [
              "first_frame_prompt",
              "video_prompt"
            ],
            "properties": {
              "first_frame_prompt": {
                "type": "string"
              },
              "last_frame_prompt": {
                "type": "string"
              },
              "video_prompt": {
                "type": "string"
              },
              "duration_sec": {
                "type": "number"
              },
              "first_frame_path": {
                "type": "string"
              },
              "last_frame_path": {
                "type": "string"
              },
              "video_path": {
                "type": "string"
              }
            }
          },
          "interaction": {
            "type": "object",
            "required": [
              "default_next_node"
            ],
            "properties": {
              "trigger_time_sec": {
                "type": "number"
              },
              "timeout_sec": {
                "type": "number"
              },
              "default_next_node": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "option_id",
                    "label",
                    "next_node"
                  ],
                  "properties": {
                    "option_id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "required_items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "grant_items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "next_node": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}