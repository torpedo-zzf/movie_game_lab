# MiniMax H3 API (metaso proxy)
MINIMAX_BASE_URL=https://metaso.cn/api/minimax
MINIMAX_API_KEY=

# Alibaba Cloud OSS (用于把首尾帧变成公网可访问 URL)
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 可选：自定义域名/公网前缀；留空用 https://<bucket>.<endpoint>
OSS_PUBLIC_BASE_URL=
# OSS 根目录前缀；上传键 = <prefix>/<子目录>/<文件名>
OSS_DIR_PREFIX=movie_game_lab
